# Database
DATABASE_URL="postgresql://user:password@localhost:5432/media_pipeline?schema=public"

# Redis Queue
REDIS_URL="redis://localhost:6379"

# Storage
UPLOAD_DIR="./uploads"

# Server
PORT=3000
NODE_ENV="development"
LOG_LEVEL="info"

# Gemini Vision AI Key (Optional — Tesseract OCR used if omitted)
GEMINI_API_KEY="your_gemini_api_key_here"
