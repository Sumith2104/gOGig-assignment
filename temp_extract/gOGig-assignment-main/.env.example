# Database (AWS RDS / PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/media_pipeline?schema=public"

# Redis Queue & Broker (AWS ElastiCache / Redis)
REDIS_URL="redis://localhost:6379"

# AWS S3 Cloud Storage Credentials (Optional — Local disk storage used if omitted)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"
AWS_S3_BUCKET_NAME="your_s3_bucket_name_here"

# Gemini Vision AI Key (Optional — Tesseract OCR used if omitted)
GEMINI_API_KEY="your_gemini_api_key_here"

# Local Storage Directory
UPLOAD_DIR="./uploads"

# Server Execution Config
PORT=3000
NODE_ENV="development"
LOG_LEVEL="info"
